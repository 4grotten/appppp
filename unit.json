{
  "listeners": {
    "*:80": {
      "pass": "routes"
    }
  },

  "routes": [
    {
      "match": {
        "uri": "/internal-static/*"
      },

      "action": {
        "share": "/app/"
      }
    },
    {
      "action": {
        "pass": "applications/django"
      }
    }
  ],

  "applications": {
    "django": {
      "type": "python 3",
      "path": "/app/",
      "module": "project.wsgi",
      "limits": {
        "timeout": 30,
        "requests": 1000
      },
      "processes": {
        "max": 8,
        "spare": 4,
        "idle_timeout": 60
      }
    }
  }
}